{
  "manifest_version": 3,
  "name": "AI Personal Firewall",
  "version": "2.1.0",
  "description": "Detect and mask 30+ PII types in AI chat apps. 100% local with confidence scoring and Luhn validation.",
  "homepage_url": "https://github.com/louiesesther-prog/ai-firewall",
  "support_url": "https://ai-firewall.org/support.html",
  "permissions": ["storage", "proxy", "privacy", "scripting", "webRequest", "webRequestBlocking", "cookies"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://copilot.microsoft.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://groq.com/*",
    "https://mistral.ai/*",
    "https://cohere.ai/*",
    "https://meta.ai/*",
    "https://deepseek.com/*",
    "https://you.com/*",
    "https://kimi.ai/*",
    "https://qwen.ai/*",
    "https://jina.ai/*",
    "https://phind.com/*",
    "https://chat.google.com/*",
    "https://ai.google.dev/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://copilot.microsoft.com/*",
      "https://gemini.google.com/*",
      "https://claude.ai/*",
      "https://perplexity.ai/*",
      "https://poe.com/*",
      "https://groq.com/*",
      "https://mistral.ai/*",
      "https://cohere.ai/*",
      "https://meta.ai/*",
      "https://deepseek.com/*",
      "https://you.com/*",
      "https://kimi.ai/*",
      "https://qwen.ai/*",
      "https://jina.ai/*",
      "https://phind.com/*",
      "https://chat.google.com/*",
      "https://ai.google.dev/*"
    ],
    "css": ["styles.css"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
