# ai-firewall environment configuration
# Copy to .env and adjust, or export these before running.

# ---- Core server ----
PORT=3000
# HOST=0.0.0.0
# API key required by REST clients, if set
# AIFW_API_KEY=your-secret-key
# Allowed CORS origin (disable wildcard)
# AIFW_CORS=https://yourapp.com

# ---- Analytics / SQLite (requires better-sqlite3) ----
AIFW_DB_PATH=ai-firewall.sqlite

# ---- Enterprise master switch ----
# Set to 1 to enable ALL enterprise modules below at once.
ENTERPRISE_ALL=1

# ---- Individual enterprise feature flags ----
# Explicit per-module flags win over ENTERPRISE_ALL.
# Use 0 / false / no / off / empty to disable a specific module.
ENTERPRISE_API_KEYS=1
ENTERPRISE_TEAMS=1
ENTERPRISE_QUOTAS=1
ENTERPRISE_SCHEDULED=1
ENTERPRISE_SSO=1
ENTERPRISE_SCIM=1
ENTERPRISE_POLICY=1
ENTERPRISE_ALERTS=1
ENTERPRISE_WEBHOOKS=1
ENTERPRISE_GUARDRAILS=1
ENTERPRISE_SHADOW=1
ENTERPRISE_RESPONSE_SCAN=1
ENTERPRISE_NETWORK_AGENT=1
ENTERPRISE_RBAC=1
ENTERPRISE_TENANCY=1
ENTERPRISE_REPORTING=1
ENTERPRISE_MARKETPLACE=1

# ---- Enterprise security ----
# HMAC key for SSO tokens. If unset, a stable internal hash is used
# (tokens stay valid across restarts). Set a strong key in production.
# AIFW_SSO_SIGNING_KEY=change-me-to-a-long-random-string

# ---- Bots ----
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=...
